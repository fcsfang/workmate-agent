# Copy this file to .env, then fill in your API key.
#
# OpenRouter example:
# LLM_MODEL_ID=moonshotai/kimi-k2.6:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# OpenAI-compatible providers are also supported as long as they expose
# the chat completions API.

LLM_MODEL_ID=moonshotai/kimi-k2.6:free
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# 多模态/视觉屏幕监测 API 配置 (可选，若主模型不支持 Vision，可配置此项分离调用)
# VISION_MODEL_ID=moonshotai/kimi-k2.6:free
# VISION_API_KEY=your-vision-api-key-here
# VISION_BASE_URL=https://openrouter.ai/api/v1


# Push Notification Settings (V0.8.4+)
# PUSH_CHANNELS: comma-separated channels (e.g. local,bark,lark)
PUSH_CHANNELS=local
# BARK_KEY (iOS app)
BARK_KEY=
# LARK_WEBHOOK_URL (Feishu custom bot)
LARK_WEBHOOK_URL=

# TTS Settings (V2.1+)
# TTS_PROVIDER can be browser or xfyun. Browser mode uses Web Speech API in the frontend.
TTS_PROVIDER=browser
XFYUN_TTS_APP_ID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
XFYUN_TTS_HOST_URL=wss://tts-api.xfyun.cn/v2/tts
XFYUN_TTS_VOICE=xiaoyan
XFYUN_TTS_SPEED=45
XFYUN_TTS_VOLUME=60
XFYUN_TTS_PITCH=50
