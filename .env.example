# Copy this file to .env, then fill in your API key.
#
# OpenRouter example:
# LLM_MODEL_ID=moonshotai/kimi-k2.6:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# OpenAI-compatible providers are also supported as long as they expose
# the chat completions API.

LLM_MODEL_ID=moonshotai/kimi-k2.6:free
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
