# Copy this file to .env, then fill in your API key.
#
# OpenRouter example:
# LLM_MODEL_ID=moonshotai/kimi-k2.6:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
#
# OpenAI-compatible providers are also supported as long as they expose
# the chat completions API.

LLM_MODEL_ID=moonshotai/kimi-k2.6:free
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Push Notification Settings (V0.8.4+)
# PUSH_CHANNELS: comma-separated channels (e.g. local,bark,lark)
PUSH_CHANNELS=local
# BARK_KEY (iOS app)
BARK_KEY=
# LARK_WEBHOOK_URL (Feishu custom bot)
LARK_WEBHOOK_URL=
